# Copie para .env (não commitado) e preencha com valores reais.
# Em produção (Vercel), as mesmas chaves vão em Project Settings → Environment Variables.

# Gmail (envio da notificação de novo agendamento)
GMAIL_USER=seuemail@gmail.com
# Senha de APP de 16 letras (myaccount.google.com/apppasswords) — nunca a senha da conta.
GMAIL_APP_PASSWORD=
# Para quem a notificação é enviada. Se omitido, usa GMAIL_USER.
NOTIFY_EMAIL=seuemail@gmail.com

# Supabase (Project Settings → API no dashboard do projeto)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role key — NUNCA a anon/public. Só é lida no servidor (api/*.js).
SUPABASE_SERVICE_ROLE_KEY=
