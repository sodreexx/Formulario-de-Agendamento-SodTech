# Porta em que o back-end vai rodar localmente.
PORT=4000

# Origem do front-end autorizada a chamar esta API (CORS). Em produção,
# troque para o domínio real do site (ex: https://agendamento.sodtech.com.br).
ALLOWED_ORIGIN=http://localhost:8443

# E-mail de destino dos leads (para onde a notificação é enviada).
NOTIFY_EMAIL=sodreedev@gmail.com

# Conta Gmail usada para ENVIAR o e-mail (pode ser a mesma do NOTIFY_EMAIL).
GMAIL_USER=sodreedev@gmail.com

# Senha de app de 16 caracteres gerada em:
# Conta Google -> Segurança -> Verificação em duas etapas -> Senhas de app
# NÃO é a sua senha normal do Gmail.
GMAIL_APP_PASSWORD=
